#!/bin/sh
# Lance GatorPXE, installé dans /usr/lib/gatorpxe.
export PYTHONPATH=/usr/lib/gatorpxe${PYTHONPATH:+:$PYTHONPATH}
# Pas de __pycache__ dans /usr/lib : dpkg ne le connaîtrait pas.
export PYTHONDONTWRITEBYTECODE=1
# -P : le dossier courant n'entre pas dans la recherche des modules.
exec /usr/bin/python3 -P -m gatorpxe "$@"
